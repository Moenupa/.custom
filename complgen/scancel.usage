scancel (<JOBIDS> || [<SCANCEL_OPTION>])...;

<SCANCEL_OPTION>
	= (--account=<ACCOUNT> || -A <ACCOUNT>)										"act only on jobs charging this account"
	| (--batch || -b)															"signal batch shell for specified job"
	| --ctld																	"send request directly to slurmctld"
	| (--cron || -c)															"cancel an scrontab job"
	| (--full || -f)															"signal batch shell and all steps for specified job"
	| (--hurry || -H)															"avoid burst buffer stage out"
	| (--interactive || -i)														"require response from user for each job"
	| (--clusters <CLUSTER> || -M <CLUSTER>)									"clusters to issue commands to"
	| (--jobname=<JOBNAMES> || -n <JOBNAMES>)									"act only on jobs with this name"
	| (--partition=<PARTITION> || -p <PARTITION>)								"act only on jobs in this partition"
	| (--quiet || -Q)															"disable warnings"
	| (--qos=<QOS> || -q <QOS>)													"act only on jobs with this quality of service"
	| (--reservation=<RESERVATION> || -R <RESERVATION>)							"act only on jobs with this reservation"
	| --sibling=<CLUSTER>														"remove an active sibling job from a federated job"
	| (--signal=<SIGNAL> || -s <SIGNAL>)										"signal to send to job, default is SIGKILL"
	| (--state=<STATE> || -t <STATE>)											"act only on jobs in this state"
	| (--user=<USER> || -u <USER>)												"act only on jobs of this user"
	| (--version || -V)															"output version information and exit"
	| (--verbose || -v)															"verbosity level"
	| (--nodelist || -w)														"act only on jobs on these nodes"
	| --wckey=<WCKEY>															"act only on jobs with this workload charactization key"
	| --help																	"show this help message"
	| --usage																	"display brief usage message"
	;

<ACCOUNT>		={{{ sacctmgr show account -nP format=account }}};
<CLUSTER>		={{{ sacctmgr show cluster -nP format=clusters }}};
<JOBIDS>		={{{ squeue --me -ho '%A|%j|%T' | tr -s '|' '\t' }}};
<JOBNAMES>		={{{ squeue --me -ho '%j|%T' | tr -s '|' '\t' }}};
<PARTITION> 	={{{ sinfo -ho '%P' }}};
<QOS>			={{{ sacctmgr show qos -nP format=name }}};
<RESERVATION>	={{{ sacctmgr show reservation -nP format=name }}};
<STATE>			=PENDING | RUNNING | SUSPENDED;
<USER>			={{{ sacctmgr show user -nP format=user }}};
<WCKEY>			={{{ squeue --me -ho '%w' }}};

<SIGNAL>
	= 1																			"SIGHUP"
	| 2																			"SIGINT"
	| 3																			"SIGQUIT"
	| 4																			"SIGILL"
	| 5																			"SIGTRAP"
	| 6																			"SIGIOT or SIGABRT"
	| 7																			"SIGEMT"
	| 8																			"SIGFPE"
	| 9																			"SIGKILL"
	| 10																		"SIGBUS"
	| 11																		"SIGSEGV"
	| 12																		"SIGSYS"
	| 13																		"SIGPIPE"
	| 14																		"SIGALRM"
	| 15																		"SIGTERM"
	| 16																		"SIGUSR1"
	| 17																		"SIGUSR2"
	| 18																		"SIGCLD or SIGCHLD"
	| 19																		"SIGPWR"
	| 20																		"SIGWINCH"
	| 21																		"SIGURG"
	| 22																		"SIGPOLL or SIGIO"
	| 23																		"SIGSTOP"
	| 24																		"SIGTSTP"
	| 25																		"SIGCONT"
	| 26																		"SIGTTIN"
	| 27																		"SIGTTOU"
	| 28																		"SIGVTALRM"
	| 29																		"SIGPROF"
	| 30																		"SIGXCPU"
	| 31																		"SIGXFSZ"
	| 32																		"SIGWAITING"
	| 33																		"SIGLWP"
	| 34																		"SIGAIO"
	;
