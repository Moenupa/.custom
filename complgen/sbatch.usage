sbatch ([<SBATCH_OPTION> | <SLURM_COMMON_OPTION>]... || --) <PATH> (<PATH> || <EXE>)...;

<SLURM_COMMON_OPTION>
	= (--account=<ACCOUNT> || -A <ACCOUNT>)										"charge job to specified account"
	| (--begin=<TIME> || -b <TIME>)												"defer job until HH:MM MM/DD/YY"
	| (--cpus-per-task=<_> || -c <_>)											"number of cpus required per task"
	| --comment=<_>																"arbitrary comment"
	| --container=<PATH>														"Path to OCI container bundle"
	| --container-id=<_>														"OCI container ID"
	| (--dependency=<LSDEP> || -d <LSDEP>)										"defer job until condition on jobid is satisfied"
	| --deadline=<TIME>															"remove the job if no ending possible before this deadline (start > (deadline - time[-min]))"
	| --gres=<GRES>																"required generic resources"
	| (--hold || -H)															"submit job in held state"
	| (--no-kill || -k)															"do not kill job on node failure"
	| (--licenses=<LSLICS> || -L <LSLICS>)										"required license, comma separated"
	| (--clusters=<CLUSTER> || -M <CLUSTER>)									"Comma separated list of clusters to issue"
	| (--distribution=<DISTRIBUTION> || -m <DISTRIBUTION>)						"distribution method for processes to nodes"
	| (--job-name=(<PATH> || <_>) || -J (<PATH> || <_>))						"name of job"
	| --mail-type=<MAIL_TYPE>													"notify on state change: BEGIN, END, FAIL or ALL"
	| --mail-user=<USER>														"who to send email notification for job state changes"
	| (--ntasks=<_> || -n <_>)													"number of tasks to run"
	| --nice[=<_>]																"decrease scheduling priority by value"
	| --ntasks-per-node=<_>														"number of tasks to invoke on each node"
	| (--nodes=<_> || -N <_>)													"number of nodes on which to run (N = min[-max])"
	| (--overcommit || -O)														"overcommit resources"
	| (--partition=<PARTITION> || -p <PARTITION>)								"partition requested"
	| --priority=<_>															"set the priority of the job to value"
	| --profile=(all|none|<DATATYPE>[,<DATATYPE>]...)							"enable acct_gather_profile for detailed data value is all or none or any combination of energy, lustre, network or task"
	| (--qos=<QOS> || -q <QOS>)													"quality of service"
	| (--quiet || -Q)															"quiet mode (suppress informational messages)"
	| (--oversubscribe || -s)													"over-subscribe resources with other jobs"
	| --spread-job																"spread job across as many nodes as possible"
	| (--time=<TIME> || -t <TIME>)												"time limit"
	| --time-min=<TIME>||<_>															"minimum time limit (if distinct)"
	| (--verbose || -v)															"verbose mode (multiple -v's increase verbosity)"
	| --cluster-constraint=[!]<LSFEAT>											"specify a list of cluster constraints"
	| --contiguous																"demand a contiguous range of nodes"
	| (--constraint=<LSFEAT> || -C <LSFEAT>)									"specify a list of constraints"
	| --mem=<_>																	"minimum amount of real memory"
	| --mem-per-cpu=<_>															"maximum amount of real memory per allocated cpu required by the job. --mem >= --mem-per-cpu if --mem is specified."
	| --mem-per-gpu=<_>															"real memory required per allocated GPU"
	| --reservation=<RESERVATION>												"allocate resources from named reservation"
	| --tmp=<_>																	"minimum amount of temporary disk"
	| (--nodelist=<LSNODE> || -w <LSNODE>)										"request a specific list of hosts"
	| (--exclude=<LSNODE> || -x <LSNODE>)										"exclude a specific list of hosts"
	| --cpus-per-gpu=<_>														"number of CPUs required per allocated GPU"
	| (--gpus=<_> || -G <_>)													"count of GPUs required for the job"
	| (--help || -h)															"show this help message"
	| --usage																	"display brief usage message"
	| (--version || -V)															"output version information and exit"
	;

<SBATCH_OPTION>
	= (--array=<_> || -a <_>)													"job array index values"
	| (--chdir=<DIRECTORY> || -D <DIRECTORY>)									"set working directory for batch script"
	| (--error=<PATH> || -e <PATH>)												"file for batch script's standard error"
	| --export=<EXPORT>															"specify environment variables to export"
	| --get-user-env															"load environment from local cluster"
	| (--input=<PATH> || -i <PATH>)												"file for batch script's standard input"
	| (--output=<PATH> || -o <PATH>)											"file for batch script's standard output"
	| --parsable																"outputs only the jobid and cluster name (if present), separated by semicolon, only on successful submission."
	| --[no]-requeue															"whether to permit the job to be requeued"
	| (--wait=<_> || -W <_>)													"wait for completion of submitted job"
	| --wrap=<EXE>																"wrap command string in a sh script and submit"
	| --exclusive[=user]														"allocate nodes in exclusive mode when cpu consumable resource is enabled"
	| --exclusive[=mcs]															"allocate nodes in exclusive mode when cpu consumable resource is enabled and mcs plugin is enabled"
	;

<ACCOUNT>		={{{ sacctmgr show account -nP format=account }}};
<CLUSTER>		={{{ sacctmgr show cluster -nP format=clusters }}};
<DATATYPE>		=task|energy|network|filesystem;
<DEP_TYPE>		=after|afterany|afterok|aftercorr|afternotok;
<DEPENDENCY>	=<DEP_TYPE>:<QUEUED_JOBIDS>[:<QUEUED_JOBIDS>]...;
<DISTRIBUTION>	=block|cyclic|arbitrary|plane;
<EXPORT>		=ALL[,ENVVAR]|NONE|NIL;
<FEATURE>		={{{ sinfo -ho %f }}};
<GRES>			={{{ sinfo -ho '%G' | sed 's/([^)]*)//g' | tr ':' '\n' | grep -v '^[0-9]' | sort -u }}};
<LICENSE>		={{{ scontrol show lic }}};
<MAIL_TYPE>		=NONE|BEGIN|END|FAIL|ALL|REQUEUE|STAGE_OUT|TIME_LIMIT|TIME_LIMIT_90|TIME_LIMIT_80|TIME_LIMIT_50|ARRAY_TASKS;
<NODE>			={{{ sinfo -ho %n }}};
<PARTITION> 	={{{ sinfo -ho '%P' }}};
<QOS>			={{{ sacctmgr show qos -nP format=name }}};
<QUEUED_JOBIDS>	={{{ squeue --me -ho '%A' }}};
<RESERVATION>	={{{ sacctmgr show reservation -nP format=name }}};
<TIME>			=now[+count(seconds|minutes|hours|days|weeks)]|HH:MM[:SS]|YYYY-MM-DD[THH:MM[:SS]];
<USER>			={{{ sacctmgr show user -nP format=user }}};

<LSDEP>			=<DEPENDENCY>[,<DEPENDENCY>]...;
<LSFEAT>		=<FEATURE>[,<FEATURE>]...;
<LSLICS>		=<LICENSE>[,<LICENSE>]...;
<LSNODE>		=<NODE>[,<NODE>]...;

<EXE>			={{{ echo '' }}};
<EXE@zsh>		={{{ compadd ${(k)commands} }}};
<EXE@fish>		={{{ __fish_complete_command }}};
