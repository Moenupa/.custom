    declare -a literals=("YYYY-MM-DDTHH:MM:SS" "--oversubscribe" "--get-user-env" "--spread-job" "--overcommit" "--contiguous" "--parsable" "arbitrary" "--version" "--verbose" "--no-kill" "HH:MM:SS" "--usage" "--quiet" "now+1s" "cyclic" "--hold" "--help" "plane" "block" "-x" "-w" "-v" "-t" "-s" "-q" "-p" "-o" "-n" "-m" "-k" "-i" "-h" "-e" "-d" "-c" "-b" "-a" "-W" "-V" "-Q" "-O" "-N" "-M" "-L" "-J" "-H" "-G" "-D" "-C" "-A" "--")
    declare -A descriptions=()
    descriptions[0]="Time in YYYY-MM-DD[THH:MM[:SS]]"
    descriptions[1]="over-subscribe resources with other jobs"
    descriptions[2]="load environment from local cluster"
    descriptions[3]="spread job across as many nodes as possible"
